{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlatScope",
  "version": "0.1.41",
  "identifier": "app.platscope.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost http://component-image.localhost component-image: https://warframe.market; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "PlatScope",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "reward-overlay",
        "title": "PlatScope — Награды",
        "url": "index.html?overlay=1",
        "width": 1292,
        "height": 400,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/THIRD_PARTY_NOTICES.md",
      "resources/reward-ocr/**/*"
    ],
    "shortDescription": "Explainable Warframe market and inventory intelligence"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5QzZBQjYwRUZFOEFGMzAKUldRd3IranZZS3ZHcVY5OVlPZ0taR1NLOWROWW9xbSszcEtwbFR5QzJOTzdlNDdRUEdPeUt5TDkK",
      "endpoints": [
        "https://github.com/Fsedis/PlatScope/releases/latest/download/latest.json?installed={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
