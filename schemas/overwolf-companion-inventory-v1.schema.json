{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platscope.local/schemas/overwolf-companion-inventory-v1.schema.json",
  "title": "PlatScope Overwolf companion inventory envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "observedAt",
    "gameId",
    "feature",
    "key",
    "complete",
    "value"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "const": "platscope-overwolf-companion"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "gameId": {
      "const": 8954
    },
    "feature": {
      "const": "match_info"
    },
    "key": {
      "const": "inventory"
    },
    "complete": {
      "const": true
    },
    "value": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "string",
          "minLength": 2
        }
      ]
    }
  }
}
